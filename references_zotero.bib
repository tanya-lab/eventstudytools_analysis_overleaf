	year = {2023},
	note = {Publisher: Elsevier Ltd},
	keywords = {Asian countries, Commerce, Energy policy, Energy utilization, Green bond, Green bonds, Indonesia, Malaysia, Panel data, Philippines, Renewable energies, Renewable energy, Renewable energy deployments, Singapore [Southeast Asia], Southeast Asia, Thailand, Trade openness, Viet Nam, alternative energy, green economy, market development, panel data, sustainable development, trade openness, trade-environment relations},
	pages = {313--319},
}

