@article{ahmed_russiaukraine_2023,
	title = {Russia–{Ukraine} crisis: {The} effects on the {European} stock market},
	volume = {29},
	issn = {1468-036X},
	shorttitle = {Russia–{Ukraine} crisis},
	url = {https://onlinelibrary.wiley.com/doi/abs/10.1111/eufm.12386},
	doi = {10.1111/eufm.12386},
	abstract = {We examine the effect of the Russia–Ukraine crisis on the European stock markets. Because of increased political uncertainty, geographic proximity and the ramifications of the fresh sanctions imposed on Russia, the European stock markets tended to react negatively to this crisis. We find that on 21 February 2022, when Russia recognized two Ukrainian states as autonomous regions, European stocks incurred a significant negative abnormal return. Moreover, the negative stock price reactions continued in the post-event period. The magnitude of the stock price reactions to this crisis exhibits considerable variation across industries, countries and size of the company.},
	language = {en},
	number = {4},
	urldate = {2025-08-20},
	journal = {European Financial Management},
	author = {Ahmed, Shaker and Hasan, Mostafa M. and Kamal, Md Rajib},
	year = {2023},
	note = {\_eprint: https://onlinelibrary.wiley.com/doi/pdf/10.1111/eufm.12386},
	keywords = {Russia–Ukraine crisis, event study, political uncertainty, stock returns},
	pages = {1078--1118},
}

@article{makkonen_geopolitical_2023,
	title = {Geopolitical conflicts, sanctions and international knowledge flows: {EU}–{Russia} collaboration during the {Ukraine} crisis},
	volume = {46},
	issn = {1467-9701},
	shorttitle = {Geopolitical conflicts, sanctions and international knowledge flows},
	url = {https://onlinelibrary.wiley.com/doi/abs/10.1111/twec.13421},
	doi = {10.1111/twec.13421},
	abstract = {This article studies the development of scientific co-publications between EU countries and Russia since the start of the Ukraine crisis in 2014. We investigate if economic sanctions and counter-sanctions imposed during the crisis affected EU–Russia knowledge flows even before all science collaborations between the EU countries and Russia were eventually suspended as part of the EU sanctions in 2022. Our econometric analysis uses a gravity model framework and a comprehensive dataset covering more than 540 million scientific publications and 8.6 million international co-publications for 35 countries (EU, BRICS, Belarus and Ukraine) during 1995–2018. Findings indicate that the imposition of EU sanctions and Russian counter-sanctions from 2014 onwards had a significantly negative effect on EU–Russia co-publication intensities. As a lower bound estimate, we find that sanctions reduced the EU–Russia scientific co-publication intensity by 15\% at the aggregate level. Effects are higher in specific scientific fields. We uncover transmission channels of this effect, for example, related to dual-use technologies and growing resentments, and assess the robustness of our estimates. Time–dynamic regressions show that the sanctions effect on scientific collaboration increases over time. This underlines the susceptibility of global knowledge flows to geopolitical conflicts.},
	language = {en},
	number = {10},
	urldate = {2025-08-20},
	journal = {The World Economy},
	author = {Makkonen, Teemu and Mitze, Timo},
	year = {2023},
	note = {\_eprint: https://onlinelibrary.wiley.com/doi/pdf/10.1111/twec.13421},
	keywords = {EU–Russia relationship, Ukraine crisis, economic sanctions, gravity model, knowledge flows, scientific co-publications},
	pages = {2926--2949},
}

