	issn = {03014207 (ISSN)},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85173164540&doi=10.1016%2fj.resourpol.2023.104188&partnerID=40&md5=857c6324f0590decffed072386cfb63a},
	doi = {10.1016/j.resourpol.2023.104188},
	abstract = {This study, spanning 1995–2020 across 24 countries, investigates the influence of green bonds and trade openness on sustainable practices in natural resource markets, impacting green economic growth. Using the Generalized Method of Moments (GMM) model, our analysis shows that green bond issuance promotes sustainable business practices in these markets, fostering environmental responsibility and resource utilization for sustainable development. Furthermore, trade openness significantly enhances sustainable practices by optimizing resource use, reducing waste, and streamlining supply chains. © 2023},
