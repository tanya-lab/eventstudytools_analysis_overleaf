	issn = {15446123 (ISSN)},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85187276783&doi=10.1016%2fj.frl.2024.105099&partnerID=40&md5=3c1f4dd6678086a82f52d9c0f23203f5},
	doi = {10.1016/j.frl.2024.105099},
