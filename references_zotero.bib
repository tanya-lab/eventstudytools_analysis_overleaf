	journal = {Transnational Corporations},
	author = {Henide, K.},
	year = {2021},
	note = {Publisher: UNCTAD United Nations Conference on Trade and Development},
	keywords = {Bayesian equilibria, adverse selection, green bonds, voluntary disclosure},
	pages = {35--63},
}

