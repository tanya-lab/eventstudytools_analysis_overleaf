@article{dou_choice_2019,
	title = {The choice of green bond financing instruments},
	volume = {6},
	issn = {23311975 (ISSN)},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85071374050&doi=10.1080%2f23311975.2019.1652227&partnerID=40&md5=a2b81cc2955009fa2b14e2fae0a3f778},
	doi = {10.1080/23311975.2019.1652227},
	abstract = {Green bonds, as one of the main tools of green finance, have become an important choice of enterprises in green industries. Therefore, it has become an important theoretical and practical hot topic whether to select and what factors affect a choice to issue labeled green bonds for enterprises that meet the standards of green bonds. This paper employs the Logit model to demonstrate the impact of policy difference on the choice of green bond financing instruments. The results indicate that the type of bonds and the purpose of raising funds are the important factors affecting enterprises to issue labeled green bonds under policy difference caused by “multi-sector supervision” on China’s bond markets. The government must make full use of these key factors to formulate relevant policies to promote the development of green bond financing market. © 2019, © 2019 The Author(s). This open access article is distributed under a Creative Commons Attribution (CC-BY) 4.0 license.},
