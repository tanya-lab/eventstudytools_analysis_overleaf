	keywords = {Announcement of the green bond issue, Central Banks, Ecological economics, Green bonds, Shares’ prices reaction},
}

@article{jankovic_does_2022,
	title = {Does transparency matter? {Evidence} from panel analysis of the {EU} government green bonds},
