	author = {Nurgaliyeva, A.M. and Kazbekova, Z.S. and Bokenchina, L.K. and Bekniyazova, D. and Bokenchin, K.K.},
	year = {2022},
	note = {Publisher: ASERS Publishing House},
	keywords = {environmental projects, green bonds, green investments, green stock exchange, sustainable development goals},
	pages = {1918--1926},
}

@article{lebelle_effect_2022,
	title = {The effect of issuance documentation disclosure and readability on liquidity: {Evidence} from green bonds},
	volume = {51},
	issn = {10440283 (ISSN)},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85118362532&doi=10.1016%2fj.gfj.2021.100678&partnerID=40&md5=10c465a790e3bdbc0429eb00a168671e},
	doi = {10.1016/j.gfj.2021.100678},
	abstract = {This paper investigates the potential effects of the disclosure and the readability of a green bond's issuance documentation on its liquidity. Using a sample of 274 green bonds issued by both corporate and financial issuers (102 unique firms) worldwide (23 countries) from 2011 to 2018, we show that both the disclosure of green bond frameworks and annual reports and their readability increase the bond's liquidity. Our results are robust to checks for endogeneity and to alternative estimation techniques. Both disclosure and readability have a more important impact on liquidity for bonds issued by nonfinancial (vs. financial) issuers, bonds with longer maturities, and those with lower credit ratings. © 2021 Elsevier Inc.},
	language = {English},
	journal = {Global Finance Journal},
