}

@article{pineiro-chousa_green_2022,
	title = {Green bond market and {Sentiment}: {Is} there a switching {Behaviour}?},
	volume = {141},
	issn = {01482963 (ISSN)},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85120305163&doi=10.1016%2fj.jbusres.2021.11.048&partnerID=40&md5=74650f1d9b9a335e0d590c39a5ab767b},
	doi = {10.1016/j.jbusres.2021.11.048},
	abstract = {We examine the impact of Twitter sentiment on the returns of four selected bond indices via the selection of relevant threshold variables, such as the S\&P 500 Index, the VIX, and the MSCI World Index. If overreaction or underreaction to significant changes in the market occur regularly (De Bondt and Thaler, 1985, 1987; Jegadeesh and Titman, 1993), it is assumed that Twitter users respond with different intensities in the case of rising, falling or rather indeterminable markets. We fail to find evidence that the S\&P 500 Index and VIX are relevant in supporting the switching behaviour. However, the MSCI World Index, to a certain extent, causes this relationship to diverge from the linear one. These claims become stronger when lagged and cubic sentiment variables have been included in the panel smooth transition regression (PSTR). © 2021 The Author(s)},
	language = {English},
