	issn = {20419945 (ISSN)},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85183906509&doi=10.1111%2fajfs.12459&partnerID=40&md5=9e281cbf54ff35b0810a470f83368c36},
	doi = {10.1111/ajfs.12459},
	abstract = {This study examines the announcement effect of a green bond on the issuer's stock returns in the Indian Stock Market. The event study methodology for data analysis and abnormal returns were calculated using the market model for the 16-day event window that includes the 5 days prior and 10 days after the issuance of the green bonds. The findings of this study show that green bond announcements do not create any significant abnormal returns, thus suggesting investors' irrationality toward environmental factors. This study informs policymakers that investor education relating to the environment is needed in India. © 2024 Korean Securities Association.},
