	volume = {15},
	issn = {17554179 (ISSN)},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85144122903&doi=10.1108%2fQRFM-02-2022-0032&partnerID=40&md5=c27102b0717ade5cc0ef323228ddfe2f},
