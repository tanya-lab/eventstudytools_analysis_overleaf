@book{mylovanov_how_2023,
	title = {How to {Identify} {Foreign} {Business} in {Russia} and {What} are the {Key} {Issues} of {Creating} and {Keeping} a {Full} {List} of the {Largest} {Foreign} {Companies} in {Russia}},
	abstract = {With the beginning of the Russian invasion of Ukraine, the world began to call on international business to sever business ties with Russia, and at the same time, some countries began to impose sanctions against entire sectors of the Russian economy. In this paper, we propose a methodological approach used by the Kyiv School of Economics to assess what foreign business in the Russian Federation is, how to correctly calculate its share in GDP, and how, in our opinion, the behavior of international companies should be assessed. According to our calculations, about {\textasciitilde}1,400 companies with total revenue of more than USD 300 billion in 2021 (about 17\% of nominal GDP) had direct business in the Russian Federation. Almost a year after the invasion, we estimate that companies accounting for about 16\% of revenue have already sold their businesses, and about half plan to do so in the near future. At the same time, we understand that companies may maintain explicit or implicit trade ties, closely monitor what we are going to do in the future and the assessment of their impact (these trade relations) on the economy will still need to be developed.},
	author = {Mylovanov, Tymofiy and Onopriienko, Andrii and Shapoval, Nataliia and Gribanovskiy, Olexiy},
	month = apr,
	year = {2023},
}

@article{abakah_impact_2023,
	title = {The impact of containment measures and monetary and fiscal responses on {US} financial markets during the {COVID}-19 pandemic},
	volume = {9},
	issn = {24058440 (ISSN)},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85152927472&doi=10.1016%2fj.heliyon.2023.e15422&partnerID=40&md5=f3a251436e8f49b3f19d56f40627a5bc},
	doi = {10.1016/j.heliyon.2023.e15422},
	abstract = {This paper analyses the effects of containment measures and monetary and fiscal responses on US financial markets during the Covid-19 pandemic. More specifically, it applies fractional integration methods to analyse their impact on the daily S\&P500, the US Treasury Bond Index (USTB), the S\&P Green Bond Index (GREEN) and the Dow Jones (DJ) Islamic World Market Index (ISLAM) over the period 1/01/2020–10/03/2021. The results suggest that all four indices are highly persistent and exhibit orders of integration close to 1. A small degree of mean reversion is observed only for the S\&P500 under the assumption of white noise errors and USTB with autocorrelated errors; therefore, market efficiency appears to hold in most cases. The mortality rate, surprisingly, seems to have affected stock and bond prices positively with autocorrelated errors. As for the policy responses, both the containment and fiscal measures had a rather limited impact, whilst there were significant announcement effects which lifted markets, especially in the case of monetary announcements. There is also evidence of a significant, positive response to changes in the effective Federal funds rate, which suggests that the financial industry, mainly benefiting from interest rises, plays a dominant role. © 2023 The Authors},
	language = {English},
	number = {5},
	journal = {Heliyon},
	author = {Abakah, E.J.A. and Caporale, G.M. and Gil-Alana, L.A.},
	year = {2023},
	note = {Publisher: Elsevier Ltd},
	keywords = {Bonds, C32, Containment measures, Covid-19, G15, Green bonds, Islamic stocks, JEL Classifications: C22, Policy responses and announcements, Stocks, US financial Markets},
}

@article{gomez_fostering_2021,
	title = {Fostering green financing at the subnational level. {The} case of the {Basque} {Country}*},
	issn = {02133865 (ISSN)},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85110725504&partnerID=40&md5=6c36ffde111a09f741ffbf26131c3ca6},
	abstract = {Although the role of the public sector in developing green financing has been analyzed, there is a gap in the literature regarding the specific funtions of subnational (or regional) governments to facilitate financing of clean technologies and sustainability projects. This research aims to contribute to the academic literature on the specific channels and mechanisms through which a regional government can facilitate green financing. To answer this question, this paper studies the role of the public sector at various administration levels (supranational, national and subnational) in facilitating the financing of sustainable investments to delineate best practices. It develops a framework to assess strategies to foster green finance, with a focus on the regional level, and applies it to the specific case of the Basque Country. Si bien se ha analizado el papel del sector público en el desarrollo de la financiación verde, existe un vacío en la literatura sobre las funciones específicas de los gobiernos sub-nacionales (o regionales) para facilitar el financiamiento de tecnologías limpias y proyectos de sostenibilidad. Esta investigación tiene como objetivo contribuir a la literatura académica sobre los canales y mecanismos específicos a través de los cuales un gobierno regional puede facilitar la financiación verde. Para responder a esta pregunta, este trabajo estudia el papel del sector público en los distintos niveles de la Administración (supranacional, nacional y sub-nacional) para facilitar la financiación de inversiones sostenibles y diseñar las mejores prácticas. Asimismo, el trabajo desarrolla un marco de evaluación de estrategias de fomento de las finanzas verdes, con un enfoque regional, y lo aplica al caso concreto del País Vasco. © 2021. All Rights Reserved.},
	language = {English},
	number = {99},
	journal = {Ekonomiaz},
	author = {Gómez, J.F. and Basterra, M.L.},
	year = {2021},
	note = {Publisher: Servicio Central Publicaciones. Gobierno vasco},
	keywords = {bonos verdes, financiación verde, finanzas sostenibles, gobiernos subestatales, green bonds, green financing, papel de los gobiernos, role of governments, subnational governments, sustainable finance},
	pages = {150--181},
}

