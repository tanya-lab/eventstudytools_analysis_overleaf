	volume = {80},
	issn = {09571787 (ISSN)},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85146088813&doi=10.1016%2fj.jup.2022.101474&partnerID=40&md5=5201a53d4ac6a78b3fcf36669e896e55},
	doi = {10.1016/j.jup.2022.101474},
	abstract = {This article examines the asymmetric green bonds-energy efficiency nexus in the top ten green bond issuer countries. Quantile-on-Quantile approach is applied, which permits the exploration of the time-series interdependence in each economy individually to give worldwide yet nation-specific details about the association between the variables. The estimates show that green bond financing boosts energy efficiency in our selected nations at various quantiles of data distribution. Furthermore, the findings show that the levels of asymmetries between the variables vary by nation, emphasizing the significance of governments paying particular consideration when enacting green financing and energy efficiency measures. © 2022 Elsevier Ltd},
