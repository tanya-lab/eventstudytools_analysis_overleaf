@article{garnov_innovative_2022,
	title = {Innovative {Financial} {Economic} {Stimulation} {Tools} {For} {ESG}-{Transformation} of a {Company}: {Opportunities} for {Application} and {Specifics} of {Regulation}},
	volume = {10},
	issn = {27644170 (ISSN)},
