@article{corrado_nonparametric_1989,
    title = {A nonparametric test for abnormal security-price performance in event studies},
    volume = {23},
    issn = {0304-405X},
    url = {https://www.sciencedirect.com/science/article/pii/0304405X89900640},
    doi = {10.1016/0304-405X(89)90064-0},
    abstract = {This paper evaluates a new nonparametric rank test for abnormal security-price performance in event studies. Simulations with daily security-return data show that the rank test is better specified under the null hypothesis and more powerful under the alternative hypothesis than the parametric t-test. Unlike previous nonparametric tests, this rank test does not require symmetry in cross-sectional excess returns distributions for correct specification.},
    number = {2},
    urldate = {2025-08-19},
    journal = {Journal of Financial Economics},
    author = {Corrado, Charles J},
    month = aug,
    year = {1989},
    pages = {385--395},
}
@article{kamal_impact_2023,
    title = {The impact of the {Russia}-{Ukraine} crisis on the stock market: {Evidence} from {Australia}},
    volume = {79},
    issn = {0927-538X},
    shorttitle = {The impact of the {Russia}-{Ukraine} crisis on the stock market},
    url = {https://www.sciencedirect.com/science/article/pii/S0927538X23001026},
    doi = {10.1016/j.pacfin.2023.102036},
    abstract = {This paper investigates the effect of the Russia–Ukraine crisis on the Australian stock market. Using the event study methodology, we find significantly negative abnormal returns on the event date (i.e., the first trading day after Russia recognized the two Ukrainian states as autonomous regions) in the Australian stock market. However, this negative stock market reaction mostly disappeared in the post-event period. We also find that small and medium-sized firms were adversely affected during the pre-event and event periods. Interestingly, the magnitude and the direction of the abnormal returns vary across industries. We also find that high-growth, illiquid and export-oriented firms are more exposed to the Russia–Ukraine crisis.},
    urldate = {2024-02-16},
    journal = {Pacific-Basin Finance Journal},
    author = {Kamal, Md Rajib and Ahmed, Shaker and Hasan, Mostafa Monzur},
    month = jun,
    year = {2023},
    keywords = {Australia, Event study, Financial contagion, Political uncertainty, Russia–Ukraine crisis, Stock returns},
    pages = {102036},
}
@article{boehmer_event-study_1991,
    title = {Event-study methodology under conditions of event-induced variance},
    volume = {30},
    issn = {0304-405X},
    url = {https://www.sciencedirect.com/science/article/pii/0304405X9190032F},
    doi = {10.1016/0304-405X(91)90032-F},
    abstract = {Many authors have identified the hazards of ignoring event-induced variance in event studies. To determine the practical extent of the problem, we simulate an event with stochastic effects. We find that when an event causes even minor increases in variance, the most commonly-used methods reject the null hypothesis of zero average abnormal return too frequently when it is true, although they are reasonably powerful when it is false. We demonstrate that a simple adjustment to the cross-sectional techniques produces appropriate rejection rates when the null is true and equally powerful tests when it is false.},
    number = {2},
    urldate = {2025-08-20},
    journal = {Journal of Financial Economics},
    author = {Boehmer, Ekkehart and Masumeci, Jim and Poulsen, Annette B.},
    month = dec,
    year = {1991},
    pages = {253--272},
}
@article{fama_size_1995,
    title = {Size and {Book}-to-{Market} {Factors} in {Earnings} and {Returns}},
    volume = {50},
    issn = {0022-1082},
    url = {https://www.jstor.org/stable/2329241},
    doi = {10.2307/2329241},
    abstract = {We study whether the behavior of stock prices, in relation to size and book-to-market-equity (BE/ME), reflects the behavior of earnings. Consistent with rational pricing, high BE/ME signals persistent poor earnings and low BE/ME signals strong earnings. Moreover, stock prices forecast the reversion of earnings growth observed after firms are ranked on size and BE/ME. Finally, there are market, size, and BE/ME factors in earnings like those in returns. The market and size factors in earnings help explain those in returns, but we find no link between BE/ME factors in earnings and returns.},
    number = {1},
    urldate = {2025-08-06},
    journal = {The Journal of Finance},
    author = {Fama, Eugene F. and French, Kenneth R.},
    year = {1995},
    note = {Publisher: [American Finance Association, Wiley]},
    pages = {131--155},
}